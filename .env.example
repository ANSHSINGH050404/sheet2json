-- PostgreSQL connection string.
#
# For Neon (recommended): open the Neon Console -> Connection Details and copy the
# pooled `postgresql://...` connection string.
#
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Any PostgreSQL 14+ database works. Copy this file to `.env.local` (gitignored)
# and fill in the real value. Never commit real credentials.
DATABASE_URL=

# --- Google sign-in -----------------------------------------------------------
#
# Without these the app still works: public sheets, the web UI and the anonymous
# API tier need no account. These two are what enable sign-in, private sheets, API
# keys and per-user history.
#
# From https://console.cloud.google.com -> APIs & Services -> Credentials ->
# "Create credentials" -> "OAuth client ID" -> "Web application".
#
# Authorized redirect URI, which must match exactly:
#   http://localhost:3000/auth/google/callback   (development)
#   https://YOUR_DOMAIN/auth/google/callback    (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Token encryption ---------------------------------------------------------
#
# Encrypts Google OAuth tokens at rest, so a leaked database is not enough to read
# anyone's private spreadsheets. Required for sign-in; the public path does not
# need it.
#
# Generate one: openssl rand -base64 32
#
# Rotating this invalidates every stored grant. Users reconnect from Settings; no
# data is lost, only the permission.
TOKEN_ENCRYPTION_KEY=

# --- Sheet assistant -----------------------------------------------------------
#
# Enables the natural-language, read-only sheet assistant. Create an API key at
# https://console.typesafe.ai/keys. This stays server-side; sheet rows are not
# sent to TypeSafe (only the prompt and column names).
TYPESAFE_API_KEY=

# --- Limits (optional) --------------------------------------------------------
#
# Every value below is optional; the default is shown as a comment. All are
# read once at startup.
#
# Maximum data rows stored per extraction.
# MAX_ROWS=10000
#
# Maximum CSV size read from Google, in bytes.
# MAX_RESPONSE_BYTES=10485760
#
# Time budget for one request to Google, in milliseconds.
# FETCH_TIMEOUT_MS=20000
#
# How long a signed-in browser session lasts, in days.
# SESSION_TTL_DAYS=30
#
# How long an in-flight sign-in may wait for its callback, in minutes.
# OAUTH_STATE_TTL_MINUTES=10
#
# Rate limits, per hour: per API key, per account across all its keys, and per IP
# for unauthenticated callers.
# RATE_LIMIT_PER_KEY=1000
# RATE_LIMIT_PER_USER=5000
# RATE_LIMIT_PER_IP=60
#
# How long a successful API extraction may be served from cache. 0 disables it.
# API_CACHE_TTL_SECONDS=60
